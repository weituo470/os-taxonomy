{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withmarble.com/taxonomy/schema/locale-clusters.schema.json",
  "title": "Marble Skill Taxonomy — cluster summary locale overlay",
  "description": "Translations of Marble-authored cluster summaries. Subject, domain and age remain the English join key.",
  "type": "object",
  "required": ["locale", "language", "sourceLocale", "sourceFile", "status", "reviewStatus", "translationMethod", "contentLicense", "databaseLicense", "attribution", "reviewNotice", "sourceProjectionSha256", "recordCount", "records"],
  "additionalProperties": false,
  "properties": {
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{4})?(?:-[A-Z]{2})?$" },
    "sourceLocale": { "const": "en" },
    "sourceFile": { "const": "clusters.json" },
    "status": { "enum": ["community-draft", "reviewed"] },
    "reviewStatus": { "enum": ["needs-native-speaker-review", "native-speaker-reviewed"] },
    "translationMethod": { "type": "string", "minLength": 1 },
    "contentLicense": { "const": "CC-BY-SA-4.0" },
    "databaseLicense": { "const": "ODbL-1.0" },
    "attribution": { "type": "string", "minLength": 1 },
    "reviewNotice": { "type": "string", "minLength": 1 },
    "sourceProjectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordCount": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "domain", "ageRangeStart", "summary"],
        "additionalProperties": false,
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "ageRangeStart": { "type": "integer" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
